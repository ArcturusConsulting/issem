# === Cargo Workspace Blocks ===
# Ignore the centralized workspace target directory at the root
/target/

# Ignore any legacy or nested cargo build directories
**/target/

# === AMR Side Block ===
# Ignore compiled/downloaded binary executables specifically
amr_side/*
# (Uncomment below if you want to keep scripts but ignore everything else safely)
# !amr_side/**/*.py
# !amr_side/**/*.yaml

# === Server Side Block ===
# Ignore your compiled shared machine asset in the running directory
server_side/operators/libvda5050_mapper.so

# === System & IDE Garbage ===
.DS_Store
.vscode/
.idea/
*.swp
*.log